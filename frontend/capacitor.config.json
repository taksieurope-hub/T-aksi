{
  "appId": "com.taksi.app",
  "appName": "T'aksi",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "permissions": {
        "background": true
      }
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#020202",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#020202"
    }
  },
  "ios": {
    "scheme": "T'aksi",
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#020202"
  }
}
